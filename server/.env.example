PORT=5000
# Cloud MongoDB Atlas Cluster URI (Whitelist 0.0.0.0/0 in Atlas Network Access)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/vitalsync?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1h
NODE_ENV=production
# Hardened Live Frontend URL (Localhost is rejected in production)
FRONTEND_URL=https://vitalsync-frontend.onrender.com,https://vitalsync.vercel.app
STRIPE_SECRET_KEY=sk_test_placeholder_or_real_stripe_test_key
GEMINI_API_KEY=your_gemini_api_key_here # Optional: Built-in clinical fallback engine works if omitted
